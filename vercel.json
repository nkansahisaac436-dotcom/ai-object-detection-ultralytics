{
  "version": 2,
  "rewrites": [
    {
      "source": "/predict",
      "destination": "/api/index.py"
    },
    {
      "source": "/health",
      "destination": "/api/index.py"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/index.py"
    },
    {
      "source": "/static/(.*)",
      "destination": "/webapp/static/$1"
    },
    {
      "source": "/",
      "destination": "/webapp/static/index.html"
    },
    {
      "source": "/(.*)",
      "destination": "/webapp/static/$1"
    }
  ]
}
