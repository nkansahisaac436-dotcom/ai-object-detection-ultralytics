{
  "expo": {
    "name": "Isaac YOLO Detection",
    "slug": "ai-object-detection-mobile",
    "owner": "heaven_bound",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0F172A",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.pentecost.isaacyolo"
    },
    "android": {
      "package": "com.pentecost.isaacyolo",
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "The app needs access to your photos to detect Isaac in your pictures.",
          "cameraPermission": "The app needs access to your camera to capture live photos for detection."
        }
      ]
    ],
    "runtimeVersion": {
      "policy": "sdkVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/a31674eb-4635-4f8c-804c-7a73cf8e4b1e"
    },
    "extra": {
      "eas": {
        "projectId": "a31674eb-4635-4f8c-804c-7a73cf8e4b1e"
      }
    }
  }
}
