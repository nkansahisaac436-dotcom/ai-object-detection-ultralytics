# Server Configuration
HOST=0.0.0.0
PORT=8000

# Path to trained YOLO weights (.pt file)
# Defaults to model/best.pt inside webapp/
MODEL_PATH=model/best.pt

# Optional: Ultralytics HUB Inference API Switch
# If USE_HUB_API is true, inference requests are sent to Ultralytics HUB API
USE_HUB_API=false
HUB_API_KEY=
HUB_MODEL_URL=
